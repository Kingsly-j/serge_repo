rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSiteAdmin() {
      return request.auth != null
        && request.auth.token.email == 'support@anthonymobilehomes.com';
    }

    match /collections/{documentId} {
      allow read: if true;
      allow create, update, delete: if isSiteAdmin();
    }

    match /reviews/{documentId} {
      allow read: if true;
      allow create, update, delete: if isSiteAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSiteAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isSiteAdmin()
          || (request.auth != null
            && get(/databases/$(database)/documents/chats/$(chatId)).data.uid == request.auth.uid);
        allow create, update, delete: if false;
      }
    }

    match /customers/{customerId} {
      allow read, write: if false;
    }

    match /trafficEvents/{documentId} {
      allow read, write: if false;
    }
  }
}
